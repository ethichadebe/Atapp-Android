# Copy to .env beside docker-compose.prod.yml on the server. Never commit .env.

# PostgreSQL — used by the postgres service and the backend's DATABASE_URL.
# The host in DATABASE_URL is the compose service name, `postgres`.
POSTGRES_USER=atapp
POSTGRES_PASSWORD=change_me
POSTGRES_DB=atapp
DATABASE_URL=postgresql://atapp:change_me@postgres:5432/atapp

# Where the site is published on the host, for the system nginx to proxy to.
# Pick a free local port. Not 13001 or 18082: the deploy uses those.
FRONTEND_PORT=127.0.0.1:8083

# Written by the deploy at every cutover. Leave them to it.
# BACKEND_IMAGE=
# FRONTEND_IMAGE=

# Optional: where the importer downloads the NGA open data from. Defaults to
# NGA's own GitHub repository.
# NGA_DATA_URL=
